[Desktop Entry]
Type=Application
Name=Comfy Launcher
Comment=Launcher and lightweight browser for portable ComfyUI
Exec=ComfyLauncher
Icon=comfylauncher
# Ties the running window to this entry on X11: Qt sets WM_CLASS from
